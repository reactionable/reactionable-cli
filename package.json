{
	"name": "@reactionable/cli",
	"version": "1.3.0",
	"description": "Reactionable cli",
	"type": "module",
	"main": "dist/index.js",
	"packageManager": "npm@12.0.2",
	"bin": {
		"reactionable": "./bin/reactionable"
	},
	"scripts": {
		"start": "npm link && tsc --watch",
		"prebuild": "rimraf ./dist",
		"build": "tsc",
		"prebuild:doc": "rimraf -rf build/docs",
		"build:doc": "typedoc",
		"lint": "biome lint --error-on-warnings .",
		"lint:ci": "biome lint --error-on-warnings --reporter=json --reporter-file=biome-report.json .",
		"test": "vitest run",
		"test:ci": "npm run test:cov",
		"prepare": "ts-dev-tools install",
		"format": "biome format --write .",
		"ci": "npm run lint && npm run build && npm run test:ci",
		"check": "biome check --error-on-warnings --write .",
		"test:cov": "vitest run --reporter=default --reporter=junit --outputFile=junit.xml --coverage.enabled --coverage.reporter=lcov --coverage.reporter=text",
		"test:watch": "vitest",
		"vitest": "vitest"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/reactionable/reactionable-cli.git"
	},
	"keywords": [
		"reactionable",
		"cli",
		"tools"
	],
	"author": "ESCEMI <contact@escemi.com>",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/reactionable/reactionable-cli/issues"
	},
	"homepage": "https://reactionable.github.io/reactionable-cli",
	"dependencies": {
		"@iarna/toml": "^2.2.5",
		"clipanion": "^4.0.0-rc.4",
		"colorette": "^2.0.20",
		"deepmerge": "^4.3.1",
		"diff": "^9.0.0",
		"eta": "^4.6.0",
		"figlet": "^1.11.4",
		"handlebars": "^4.7.9",
		"inversify": "^8.2.3",
		"js-ini": "^1.6.0",
		"parse-github-url": "^1.0.4",
		"pluralize": "^8.0.0",
		"prompts": "^2.4.2",
		"reflect-metadata": "^0.2.2",
		"shelljs": "^0.10.0",
		"typescript": "^5.9.3"
	},
	"devDependencies": {
		"@ts-dev-tools/core": "^1.13.1",
		"@types/diff": "^8.0.0",
		"@types/figlet": "^1.7.0",
		"@types/mock-fs": "^4.13.4",
		"@types/parse-github-url": "^1.0.3",
		"@types/prompts": "^2.4.9",
		"@types/shelljs": "^0.10.0",
		"@types/tmp": "^0.2.6",
		"fs-extra": "^11.4.0",
		"mock-fs": "^5.5.0",
		"mock-spawn": "^0.2.6",
		"rimraf": "^6.1.3",
		"tmp": "^0.2.7",
		"typedoc": "^0.28.19"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"tsDevTools": {
		"version": "20260604100000-migrate-to-vitest"
	}
}
