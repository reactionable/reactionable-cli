{
	"compilerOptions": {
		"module": "NodeNext",
		"declaration": true,
		"noImplicitAny": false,
		"removeComments": true,
		"noLib": false,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"target": "es2022",
		"sourceMap": true,
		"strict": true,
		"rootDir": "./src",
		"types": ["node"],
		"outDir": "./dist",
		"esModuleInterop": true,
		"moduleResolution": "NodeNext"
	},
	"include": ["src/**/*"],
	"exclude": ["__tests__", "src/tests", "dist", "**/*.spec.ts"]
}
